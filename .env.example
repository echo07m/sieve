# ── 数据库 ─────────────────────────────────────────────────────
# MySQL 连接串，格式：mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql://user:password@localhost:3306/juhegui

# ── Kimi OAuth（后端）─────────────────────────────────────────
# 以下值从 Kimi 开放平台（开放平台控制台 → 你的应用）获取
APP_ID=your-kimi-app-id               # 应用 ID
APP_SECRET=your-kimi-app-secret       # 应用密钥（同时用于 JWT 会话签名，请使用高强度随机串）
KIMI_AUTH_URL=https://auth.kimi.com   # Kimi OAuth 授权服务地址
KIMI_OPEN_URL=https://open.kimi.com   # Kimi 开放平台 API 地址

# ── Kimi OAuth（前端，经 Vite 暴露到浏览器，勿放密钥）──────────
VITE_KIMI_AUTH_URL=https://auth.kimi.com  # Kimi OAuth 授权服务地址（与后端一致）
VITE_APP_ID=your-kimi-app-id              # 应用 ID（与后端 APP_ID 一致）

# ── 管理员 ────────────────────────────────────────────────────
# 应用创建者的 Union ID；该账号首次登录自动获得 admin 角色
OWNER_UNION_ID=your-owner-union-id

# ── 可选：LLM 语义召回通道 ────────────────────────────────────
# 不配置 LLM_API_KEY 时，LLM 召回通道自动关闭，规则引擎独立可用。
# LLM 仅做候选召回（命中降一级置信），最终判定权在规则引擎。
# LLM_API_KEY=your-llm-api-key                              # 大模型 API Key
# LLM_API_BASE=https://api.moonshot.cn/v1                   # 兼容 OpenAI Chat Completions 的端点
# LLM_MODEL=moonshot-v1-32k                                 # 模型名
